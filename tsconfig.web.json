{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "strict": true,
    "skipLibCheck": true, "noEmit": true, "composite": true,
    "jsx": "preserve", "allowSyntheticDefaultImports": true,
    "baseUrl": ".", "paths": {"@/*": ["src/renderer/src/*"]},
    "types": ["vite/client"]
  },
  "include": ["src/renderer/src/**/*.ts", "src/renderer/src/**/*.vue", "src/renderer/src/**/*.d.ts", "src/shared/**/*.ts"]
}
